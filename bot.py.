
import os
import json
import sqlite3
import urllib.request
import urllib.parse

BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", "")
FEED_URL = os.getenv("FEED_URL", "")

MAX_PRICE = 40

CLOTHING_WORDS = [
    "tshirt", "t-shirt", "tee", "hoodie", "sweat",
    "jacket", "veste", "pantalon", "pants", "jogging",
    "short", "legging", "shirt", "maillot", "pull",
    "coat", "fleece", "polaire", "windbreaker", "zip"
]

SHOE_WORDS = [
    "sneakers", "shoes", "chaussures", "basket",
    "air max", "air force", "boots", "bottes"
]

GOOD_CONDITIONS = [
    "new", "neuf", "neuve", "very good",
    "tres bon", "très bon", "excellent"
]

db = sqlite3.connect("cart3r.db")
db.execute("""
CREATE TABLE IF NOT EXISTS seen (
    item_id TEXT PRIMARY KEY
)
""")
db.commit()


def send_telegram(message):
    if not BOT_TOKEN or not CHAT_ID:
        print("Identifiants Telegram manquants.")
        return

    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    data = urllib.parse.urlencode({
        "chat_id": CHAT_ID,
        "text": message,
        "disable_web_page_preview": "true"
    }).encode()

    request = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(request, timeout=20) as response:
        print(response.read().decode())


def check_item(item):
    title = str(item.get("title", "")).lower()
    category = str(item.get("category", "")).lower()
    condition = str(item.get("condition", "")).lower()

    item_id = str(item.get("id", ""))
    url = str(item.get("url", ""))

    try:
        price = float(item.get("price", 999999))
    except (ValueError, TypeError):
        return

    text = title + " " + category

    if not item_id or not url or price > MAX_PRICE:
        return

    if any(word in text for word in SHOE_WORDS):
        return

    if not any(word in text for word in CLOTHING_WORDS):
        return

    if not any(word in condition for word in GOOD_CONDITIONS):
        return

    if db.execute(
        "SELECT 1 FROM seen WHERE item_id = ?", (item_id,)
    ).fetchone():
        return

    message = (
        "🚨 NOUVELLE ANNONCE CART3R 🚨\n\n"
        f"👕 {item.get('title', 'Sans titre')}\n"
        f"🏷️ Marque : {item.get('brand', 'Non précisée')}\n"
        f"💶 Prix : {price:.2f} €\n"
        f"📏 Taille : {item.get('size', 'Non précisée')}\n"
        f"🌍 Pays : {item.get('country', 'Non précisé')}\n"
        f"🔗 {url}\n\n"
        "Vérifie l'annonce avant tout achat."
    )

    send_telegram(message)

    db.execute("INSERT INTO seen VALUES (?)", (item_id,))
    db.commit()


def main():
    if not FEED_URL:
        print("Aucune source d'annonces configurée.")
        return

    request = urllib.request.Request(
        FEED_URL,
        headers={"User-Agent": "CART3R-Profit-Radar/1.0"}
    )

    with urllib.request.urlopen(request, timeout=30) as response:
        data = json.loads(response.read().decode("utf-8"))

    items = data if isinstance(data, list) else data.get("items", [])

    for item in items:
        check_item(item)

    print(f"Scan terminé : {len(items)} annonces examinées.")


if __name__ == "__main__":
    main()
